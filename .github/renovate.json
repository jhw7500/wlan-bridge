{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "timezone": "Asia/Seoul",
  "schedule": ["every weekend"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^jhw7500/automation"],
      "groupName": "automation workflows",
      "automerge": false,
      "semanticCommitType": "chore",
      "semanticCommitScope": "automation",
      "commitMessagePrefix": "🔧 ",
      "prTitle": "Update automation workflows to {{newVersion}}",
      "prBodyTemplate": "This PR updates automation workflows to version {{newVersion}}.\n\n### Changelog\n{{{changelog}}}\n\n### Files Updated\n{{{files}}}",
      "labels": ["dependencies", "automation"],
      "reviewers": ["jhw7500"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^actions/", "^google-github-actions/", "^anomalyco/"],
      "groupName": "github-actions",
      "automerge": false,
      "schedule": ["every weekend"]
    }
  ]
}
