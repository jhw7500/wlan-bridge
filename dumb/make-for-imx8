#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# SDK_LOC should point to the Yocto SDK root that contains:
# - environment-setup-<SDK_NAME>
# - sysroots/<SDK_NAME>/...
if [ -z "${SDK_LOC:-}" ]; then
    if [ -e "/shared/fsl-imx-xwayland/6.6-nanbield/environment-setup-armv8a-poky-linux" ]; then
        SDK_LOC=/shared/fsl-imx-xwayland/6.6-nanbield
    else
        SDK_LOC="$SCRIPT_DIR"
    fi
fi

[ -z "${SDK_NAME:-}" ] && SDK_NAME=armv8a-poky-linux

[ ! -e "${SDK_LOC}/environment-setup-${SDK_NAME}" ] && {
    echo "Sorry, please verify: ${SDK_LOC}/environment-setup-${SDK_NAME}" >&2
    exit 1
}

. "${SDK_LOC}/environment-setup-${SDK_NAME}"
#. ./environment-setup-${SDK_NAME}

SYSROOT="${SDK_LOC}/sysroots/${SDK_NAME}"
PKG_CONFIG_SYSROOT_DIR="$SYSROOT"
PKG_CONFIG_PATH="$SYSROOT/usr/lib/pkgconfig:$SYSROOT/usr/share/pkgconfig"
PKG_CONFIG_LIBDIR="$SYSROOT/usr/lib/pkgconfig:$SYSROOT/usr/share/pkgconfig"

#SYSROOT_COMPONENT=/opt/desktop/build-desktop/tmp/sysroots-components/cortexa53-crypto
#export GLIBS="-I${SYSROOT_COMPONENT}/glib-2.0/usr/include/glib-2.0 -I${SYSROOT_COMPONENT}/glib-2.0/usr/lib/glib-2.0/include"

PKG_CONFIG_SYSROOT_DIR="$PKG_CONFIG_SYSROOT_DIR" \
    PKG_CONFIG_PATH="$PKG_CONFIG_PATH" \
    PKG_CONFIG_LIBDIR="$PKG_CONFIG_LIBDIR" \
    PKG_CONFIG_DIR= \
    make \
        CC="$CC" \
        CFLAGS="${CFLAGS:-}" \
        LDFLAGS_PCAP="${LDFLAGS:-} -lpcap -pthread" \
        LDFLAGS_TPACKET="${LDFLAGS:-} -pthread" \
        "$@"
